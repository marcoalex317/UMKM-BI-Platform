# =============================================================
# Konfigurasi koneksi database
# Salin file ini menjadi .env lalu sesuaikan bila perlu.
# =============================================================

# Engine yang dipakai: "sqlite" (default, tanpa instalasi) atau "postgres"
DB_ENGINE=sqlite

# ---- Pengaturan SQLite (dipakai jika DB_ENGINE=sqlite) ----
# Path relatif terhadap root project.
SQLITE_PATH=data/umkm_bi.db

# ---- Pengaturan PostgreSQL (dipakai jika DB_ENGINE=postgres) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=umkm_bi
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
